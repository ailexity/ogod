# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins for CORS (admin panel, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ---- Database ----
# MongoDB Atlas connection string (start on the free M0 tier).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ogod?retryWrites=true&w=majority

# ---- Auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# OTP behavior
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# In development, OTPs are returned in the API response and logged instead of
# being sent over SMS. Set to false only when a real SMS provider is configured.
OTP_DEV_MODE=true

# ---- SMS provider (OTP delivery) ----
# Choose one: msg91 | twilio | none
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_SENDER_ID=OGODAP
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- AWS S3 (media storage) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ogod-media
# CloudFront distribution domain used to serve uploaded assets (optional).
CDN_BASE_URL=

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ---- Admin bootstrap ----
# First admin account is created/promoted with this mobile number on seed.
ADMIN_MOBILE=9270587627
